// nextflow.config for Long-Read Nanopore Analysis Pipeline

manifest {
    name            = 'longvarmeth'
    author          = 'Jyotirmoy Das'
    description     = 'LongVarMeth: Long-Read Variant Calling and Methylation Analysis Pipeline'
    mainScript      = 'main.nf'
    version         = '0.2.1'
}

// Load params.config FIRST so parameters are available to other configs
includeConfig 'conf/params.config'


// Export these variables to prevent local Python/R libraries from conflicting with those in the container
env {
    PYTHONNOUSERSITE = 1
    HOME             = "/tmp"
    R_LIBS_USER      = ""
    R_LIBS_SITE      = ""
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}

profiles {
    // Species profiles
    human {
        includeConfig "conf/human.config"
    }

    eukaryote {
        includeConfig "conf/eukaryote.config"
    }

    prokaryote {
        includeConfig "conf/prokaryote.config"
    }

    virus {
        includeConfig "conf/virus.config"
    }

    version_lock {
        includeConfig "conf/version_lock.config"
    }

    test {
        includeConfig "conf/test.config"
    }
}

// Retry only on known transient/OOM signals, NOT on general errors (exit 1)
// Exit 143=SIGTERM, 137=OOM-kill, 104=ECONNRESET, 134=SIGABRT, 139=SIGSEGV
process.errorStrategy = { task.exitStatus in [143,137,104,134,139,null] ? 'retry' : 'finish' }
process.maxRetries = 3

// FORCE sequential staging to avoid connection rate limiting
nextflow.maxParallelTransfers = 1

// Load generic execution and resource configurations
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
includeConfig 'conf/resources.config'
includeConfig 'conf/dag.config'
includeConfig 'conf/profile.config'
