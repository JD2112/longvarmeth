// conf/tests/test_pacbio.config
// Test profile for PacBio HiFi data testing using nf-core/test-datasets

params {
    config_profile_name        = 'PacBio Test Profile'
    config_profile_description = 'Minimal PacBio HiFi test dataset from nf-core/test-datasets'

    // Resource limits
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '2.h'

    // Inputs
    platform   = 'pacbio'
    species    = 'human'
    run_type   = 'reference_based'

    input      = "${projectDir}/tests/csv/samplesheet_pacbio_test.csv"
    outdir     = "results_test_pacbio"

    // Reference from nf-core test-datasets
    ref_nuc    = "https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/pacvar/pacbio_data/C9ORF72-12.fa"

    // Tools
    snv_caller              = 'bcftools'
    sv_caller               = 'sniffles'
    phasing_tool            = 'hiphase'
    cnv_caller              = 'cnvkit'
    enable_phasing          = true
    enable_phi_sanitization = true
    enable_audit_trail      = true

    // Thresholds
    min_barcode_size_mb     = 0
    filt_min_len            = 50
    filt_keep_pct           = 100
}
