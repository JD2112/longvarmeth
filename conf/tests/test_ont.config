// conf/tests/test_ont.config
// Minimal Oxford Nanopore test profile for CI, stub checks, and functional testing

params {
    config_profile_name        = 'Nanopore Test Profile'
    config_profile_description = 'Minimal Oxford Nanopore test dataset for pipeline validation'

    // Resource limits
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '2.h'

    // Input & Platform
    platform   = 'ont'
    species    = 'prokaryote'
    run_type   = 'de_novo_assembly'

    input      = "${projectDir}/tests/samplesheet_test.csv"
    outdir     = "results_test_ont"

    // Basecalling stub parameters
    dorado_bin  = "echo"
    gpu_devices = "cpu"
    threads     = 2

    // Relaxed quality thresholds
    min_barcode_size_mb = 0
    filt_min_len        = 100
    filt_keep_pct       = 100

    // References
    ref_nuc    = "${projectDir}/tests/data/ref_nuc.fasta"
}
