// conf/tests/test_giab.config
// GIAB HG002 benchmarking profile for small variants (hap.py) and SVs (truvari)

params {
    config_profile_name        = 'GIAB HG002 Benchmarking Profile'
    config_profile_description = 'GIAB HG002 truth-set benchmarking profile using hap.py and Truvari'

    // Resource limits
    max_cpus   = 4
    max_memory = '8.GB'
    max_time   = '4.h'

    // Inputs & Mode
    platform   = 'ont'
    species    = 'human'
    run_type   = 'reference_based'

    input      = "${projectDir}/tests/samplesheet_test.csv"
    outdir     = "results_test_giab"

    // References
    ref_nuc    = "${projectDir}/tests/data/ref_nuc.fasta"

    // Benchmarking parameters
    run_benchmarking       = true
    benchmark_truth_vcf    = "${projectDir}/tests/data/giab/hg002_truth_smallvar.vcf.gz"
    benchmark_truth_bed    = "${projectDir}/tests/data/giab/hg002_benchmark_regions.bed"
    benchmark_sv_truth_vcf = "${projectDir}/tests/data/giab/hg002_truth_sv.vcf.gz"
    benchmark_sv_truth_bed = "${projectDir}/tests/data/giab/hg002_benchmark_sv_regions.bed"

    // Dorado stub parameters
    dorado_bin  = "echo"
    gpu_devices = "cpu"
    threads     = 2

    // Quality thresholds
    min_barcode_size_mb = 0
    filt_min_len        = 100
    filt_keep_pct       = 100
}

