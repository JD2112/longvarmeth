// conf/eukaryote.config for Artemia and general eukaryotes

params {
    species          = "eukaryote"
    run_type         = "reference_based"
    
    // Eukaryote references (specify custom FASTA via CLI or config)
    ref_nuc          = ""
    ref_mt_ap        = ""
    ref_mt_au        = ""
    
    // Eukaryote specific variant parameters
    ploidy           = 2
    min_cov          = 10
    min_pct          = 20
    min_nmod         = 3
}
