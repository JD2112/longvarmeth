// conf/modules.config
// Centralized process arguments, publish directives, and container configuration

process {
    // Default publication settings for all processes
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'FASTQC' {
        ext.args = '--quiet'
        publishDir = [
            path: { "${params.outdir}/qc/fastqc" },
            mode: 'copy'
        ]
    }

    withName: 'NANOPLOT' {
        publishDir = [
            path: { "${params.outdir}/qc/nanoplot/${meta_id ?: task.index}" },
            mode: 'copy'
        ]
    }

    withName: 'CRAMINO' {
        publishDir = [
            path: { "${params.outdir}/qc/cramino" },
            mode: 'copy'
        ]
    }

    withName: 'FILTLONG' {
        publishDir = [
            path: { "${params.outdir}/qc/filtlong" },
            mode: 'copy'
        ]
    }

    withName: 'FLYE' {
        ext.args = '--nano-hq'
        publishDir = [
            path: { "${params.outdir}/assembly/flye" },
            mode: 'copy'
        ]
    }

    withName: 'MEDAKA' {
        publishDir = [
            path: { "${params.outdir}/assembly/medaka" },
            mode: 'copy'
        ]
    }

    withName: 'QUAST' {
        publishDir = [
            path: { "${params.outdir}/qc/quast" },
            mode: 'copy'
        ]
    }

    withName: 'BUSCO' {
        publishDir = [
            path: { "${params.outdir}/qc/busco" },
            mode: 'copy'
        ]
    }

    withName: '.*:ALIGN_(NUC|MT_AP|MT_AU)' {
        ext.args = '-ax map-ont'
    }

    withName: '.*SORT_.*' {
        publishDir = [
            path: { "${params.outdir}/alignments" },
            mode: 'copy'
        ]
    }

    withName: 'TRANSFER_TAGS.*' {
        publishDir = [
            path: { "${params.outdir}/alignments/tagged" },
            mode: 'copy'
        ]
    }

    withName: '.*CALL_.*' {
        publishDir = [
            path: { "${params.outdir}/variants/raw" },
            mode: 'copy'
        ]
    }

    withName: 'BCFTOOLS_CONCAT' {
        publishDir = [
            path: { "${params.outdir}/variants" },
            mode: 'copy'
        ]
    }

    withName: 'WHATSHAP_PHASE' {
        publishDir = [
            path: { "${params.outdir}/variants/phased" },
            mode: 'copy'
        ]
    }

    withName: 'WHATSHAP_HAPLOTAG' {
        publishDir = [
            path: { "${params.outdir}/alignments/haplotagged" },
            mode: 'copy'
        ]
    }

    withName: 'SNIFFLES' {
        publishDir = [
            path: { "${params.outdir}/variants/svs" },
            mode: 'copy'
        ]
    }

    withName: 'CNVKIT' {
        publishDir = [
            path: { "${params.outdir}/variants/cnvs" },
            mode: 'copy'
        ]
    }

    withName: '.*MOD_.*' {
        publishDir = [
            path: { "${params.outdir}/methylation" },
            mode: 'copy'
        ]
    }

    withName: 'JBROWSE_CREATE' {
        publishDir = [
            path: { "${params.outdir}/jbrowse" },
            mode: 'copy'
        ]
    }

    withName: 'MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: 'copy'
        ]
    }

    withName: 'PBMM2_ALIGN' {
        publishDir = [
            path: { "${params.outdir}/alignments/pbmm2" },
            mode: 'copy'
        ]
    }

    withName: 'TRGT' {
        publishDir = [
            path: { "${params.outdir}/variants/trgt" },
            mode: 'copy'
        ]
    }

    withName: 'HIPHASE' {
        publishDir = [
            path: { "${params.outdir}/variants/phased_hiphase" },
            mode: 'copy'
        ]
    }

    withName: 'HIFINCNV' {
        publishDir = [
            path: { "${params.outdir}/variants/cnvs_hificnv" },
            mode: 'copy'
        ]
    }

    withName: '.*GENERATE_AUDIT_MANIFEST' {
        publishDir = [
            path: { "${params.outdir}/audit" },
            mode: 'copy'
        ]
    }

    withName: 'METHYLATION_DASHBOARD' {
        publishDir = [
            path: { "${params.outdir}/reports/methylation" },
            mode: 'copy'
        ]
    }
}
