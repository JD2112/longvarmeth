// conf/prokaryote.config for Bacteria and other haploid prokaryotes

params {
    species   = "prokaryote"
    run_type  = "de_novo_assembly"
    
    // Prokaryotes are haploid
    ploidy    = 1
    
    // Default reference genome placeholder
    ref_nuc   = ""
    ref_mt_ap = ""
    ref_mt_au = ""
    
    min_cov        = 5
    min_pct        = 10
    min_nmod       = 2
    busco_lineage  = "bacteria_odb10"
}
