// conf/test.config
// Standard nf-core test profile with minimal synthetic/stubbed dataset

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function and CI'

    // Limit resources for test runners / GitHub Actions
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    // Input data
    input      = "${projectDir}/tests/samplesheet_test.csv"
    outdir     = "results_test"
    
    // Workflow behavior
    species    = "prokaryote"
    run_type   = "de_novo_assembly"

    // Basecalling stub parameters
    dorado_bin  = "echo"
    gpu_devices = "cpu"
    threads     = 2

    // Quality thresholds relaxed for small test
    min_barcode_size_mb = 0
    filt_min_len        = 100
    filt_keep_pct       = 100

    // References
    ref_nuc    = "${projectDir}/tests/data/ref_nuc.fasta"
}
