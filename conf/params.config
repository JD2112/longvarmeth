params {
    // Input/Output options
    input                   = "samplesheet.csv"
    outdir                  = "results"
    
    // Workflow behavior defaults
    platform                = "ont"             // 'ont', 'pacbio', 'auto'
    species                 = "eukaryote"       // 'human', 'eukaryote', 'prokaryote', 'virus'
    run_type                = "reference_based" // 'reference_based', 'de_novo_assembly'
    
    // Modular Tool Selector
    snv_caller              = "bcftools"        // 'bcftools', 'deepvariant', 'clair3'
    sv_caller               = "sniffles"        // 'sniffles', 'severus', 'pbsv'
    phasing_tool            = "whatshap"        // 'whatshap', 'hiphase'
    cnv_caller              = "cnvkit"          // 'cnvkit', 'hificnv'
    
    // Clinical Governance & PHI Sanitization (JD2112/milou inspired)
    enable_phi_sanitization = true
    enable_audit_trail      = true

    // Empirical Truth-Set Benchmarking (GIAB HG002)
    run_benchmarking        = false
    benchmark_truth_vcf     = ""
    benchmark_truth_bed     = ""
    benchmark_sv_truth_vcf  = ""
    benchmark_sv_truth_bed  = ""
    
    // Modular Stage Execution Toggles
    skip_variants           = false             // Skip small and structural variant calling
    skip_methylation        = false             // Skip 5mC/5hmC pileup and methylation analysis
    skip_alignment          = false             // Automatically true if input_type is 'aligned_bam'
    
    // Tandem Repeats (STR)
    enable_trgt             = false
    repeat_bed              = ""

    // Dorado GPU parameters (executed on host or via container)
    dorado_bin              = "dorado"
    gpu_devices             = "cuda:all"
    threads                 = 32
    
    // Quality thresholds
    min_barcode_size_mb     = 100
    filt_min_len            = 1000
    filt_keep_pct           = 90
    
    // References (default settings)
    ref_nuc                 = ""
    ref_mt_ap               = ""
    ref_mt_au               = ""
    
    // Module default options
    ploidy                  = 2
    enable_phasing          = false
    medaka_model            = "r1041_e82_400bps_hac_v4.0.0"
    busco_lineage           = "eukaryota"
    methylartist_locus      = ""

    // Resource limit defaults
    max_memory              = '500.GB'
    max_cpus                = 128
    max_time                = '240.h'

    // Annotation options
    enable_snpeff           = false
    snpeff_db               = "GRCh38.105"
    snpeff_cache            = ""
    
    enable_vep              = false
    vep_species             = "homo_sapiens"
    vep_assembly            = "GRCh38"
    vep_version             = "110"
    vep_cache               = ""

    // Clinical Methylation Dashboard (adapted from gms-nallo)
    enable_methylation_dashboard = false

    // Visualization options
    skip_jbrowse                 = false
}
