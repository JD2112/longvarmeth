/*
========================================================================================
    Fraka Server Configuration Profile
========================================================================================
    Defines host-specific binary paths, GPU resources, and Singularity settings
    for running the pipeline on the Fraka server.
----------------------------------------------------------------------------------------
*/

params {
    // Dorado GPU parameters on Fraka host
    dorado_bin          = 'dorado' // Resolves via PATH or module load dorado
    gpu_devices         = 'cuda:all'
    threads             = 32

    // Fraka compute resource limits
    max_cpus            = 128
    max_memory          = '500.GB'
    max_time            = '240.h'
}

singularity {
    enabled             = true
    autoMounts          = true
    runOptions          = '--nv --no-home -e -B /data:/data'
}

executor {
    name                = 'local'
    cpus                = 128
    memory              = '500.GB'
    queueSize           = 16
}
