// conf/virus.config for Viral genomes (SARS-CoV-2, HIV, phages, amplicon/metagenomics)

params {
    species                 = "virus"
    run_type                = "reference_based"
    
    // Viral genomes are haploid & high-heterogeneity/quasispecies
    ploidy                  = 1
    enable_phasing          = false
    
    // Default reference genome placeholder (can be overridden by --ref_nuc)
    ref_nuc                 = ""
    ref_mt_ap               = ""
    ref_mt_au               = ""
    
    // Relaxed coverage & variant thresholds for low-frequency viral variants / quasispecies
    min_cov                 = 5
    min_pct                 = 5
    min_nmod                = 2
    
    // Quality & filtering for viral amplicons / short fragments
    min_barcode_size_mb     = 0
    filt_min_len            = 200
    filt_keep_pct           = 95

    // Assembly preset (when run_type == 'de_novo_assembly')
    flye_args               = "--meta"
}
