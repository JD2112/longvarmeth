// conf/human.config for Human WGS/WES analysis

params {
    species   = "human"
    run_type  = "reference_based"
    
    // Human reference (provide custom path or override via CLI)
    ref_nuc   = "/data/references/hg38.fa"
    ref_mt_ap = ""
    ref_mt_au = ""
    
    ploidy    = 2
    min_cov   = 20
    min_pct   = 10
    min_nmod  = 5
}
